# ===== 外卖订单数据分析大屏 - 环境变量示例 =====
# 复制本文件为 .env 并按需修改；禁止提交真实 .env 文件。

# 应用环境：development / production
APP_ENV=development

# 应用名称
APP_NAME=外卖订单数据分析大屏

# FastAPI 调试模式
DEBUG=true

# API 服务监听
API_HOST=127.0.0.1
API_PORT=8000

# 模拟数据条数
SAMPLE_DATA_ROWS=5000

# 随机种子（保证数据可复现）
RANDOM_SEED=42

# SQLite 数据库连接（仅占位，本项目使用本地文件）
DATABASE_URL=sqlite:///data/takeout.db

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/app.log

# 以下为占位密钥示例，本项目实际不使用真实外部密钥
# 请勿在此填入任何真实凭据
SECRET_KEY=please-replace-with-your-own-secret-key-placeholder
